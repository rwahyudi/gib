# bash completion loader for packaged ib installs
# shellcheck shell=bash
# shellcheck disable=SC1090 # The installed ib binary generates this script.

if [[ -n ${BASH_VERSION:-} ]]; then
  _ib_binary=$(command -v ib 2>/dev/null || true)
  if [[ -n ${_ib_binary:-} && -x ${_ib_binary:-} ]]; then
    source <("${_ib_binary}" config completion bash 2>/dev/null)
  fi
  unset _ib_binary
fi
